/**
  * @remarks
  * Logs the data of a Map.
  *
  * @param {Minecraft.Player} player
  * @param {Map<any, any> | any} mapInstance
  */
function consoleMap(player, mapInstance) {
  if (!(mapInstance instanceof Map)) player.sendMessage('Not a map.');
  let mapData = JSON.stringify(Object.fromEntries(mapInstance), undefined, 2);
  player.sendMessage(`Map console:\n${mapData}`);
};

