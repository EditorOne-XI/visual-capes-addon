{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "visualcapes:fire_spiral",
			"basic_render_parameters": {
				"material": "particles_alpha",
				"texture": "textures/flame_atlas"
			}
		},
		"events": {
			"strike": {
				"particle_effect": {
					"effect": "visualcapes:sky_burst",
					"type": "emitter"
				}
			}
		},
		"components": {
			"minecraft:emitter_initialization": {
				"creation_expression": "v.size = 0.5;v.height = 8;v.radius = 8;v.turns = 8;"
			},
			"minecraft:emitter_local_space": {
				"position": true,
				"rotation": true
			},
			"minecraft:emitter_rate_steady": {
				"spawn_rate": "Math.random(50, 80)",
				"max_particles": 1000
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 6
			},
			"minecraft:emitter_lifetime_events": {
				"timeline": {
					"5.00": "strike"
				}
			},
			"minecraft:emitter_shape_point": {},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "Math.random(5, 6) - v.emitter_age"
			},
			"minecraft:particle_motion_parametric": {
				"relative_position": ["((v.particle_random_2 * 0.7) - 0.25) + Math.sin(v.particle_age * v.turns * 30) * v.radius", "variable.particle_age * v.height", "((v.particle_random_2 * 0.7) - 0.25) + Math.cos(v.particle_age * v.turns * 30) * v.radius"]
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["v.size", "v.size"],
				"facing_camera_mode": "lookat_xyz",
				"uv": {
					"texture_width": 16,
					"texture_height": 512,
					"flipbook": {
						"base_UV": [0, "Math.floor(Math.random(1,16)) * 16"],
						"size_UV": [16, 16],
						"step_UV": [0, 16],
						"frames_per_second": 32,
						"max_frame": 16,
						"loop": true
					}
				}
			}
		}
	}
}
