{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "visualcapes:collector_idle",
			"basic_render_parameters": {
				"material": "particles_alpha",
				"texture": "textures/particle/ascii_sga"
			}
		},
		"components": {
			"minecraft:emitter_initialization": {
				"creation_expression": "v.size = 0.1;"
			},
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 100,
				"max_particles": 100
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 2
			},
			"minecraft:emitter_shape_point": {},
			"minecraft:particle_initialization": {
				"per_render_expression": "v.letter = Math.floor(Math.random(0,25))*9;"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "v.emitter_lifetime-Math.random(0, 0.5)"
			},
			"minecraft:particle_expire_if_not_in_blocks": ["minecraft:air"],
			"minecraft:particle_motion_parametric": {
				"relative_position": ["Math.cos((variable.particle_age * 360) + (variable.particle_random_1 * 360))/1.5", "v.particle_random_2*2", "Math.sin((variable.particle_age * 360) + (variable.particle_random_1 * 360))/1.5"]
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["v.size*(1-(v.particle_age/3))", "v.size*(1-(v.particle_age/3))"],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 234,
					"texture_height": 9,
					"uv": ["v.letter", 0],
					"uv_size": [8, 8]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#FFFFC000",
						"0.33": "#FFFF0000",
						"1.0": "#FF200000"
					}
				}
			}
		}
	}
}