{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "visualcapes:bind_effect",
			"basic_render_parameters": {
				"material": "particles_alpha",
				"texture": "textures/particle/particles"
			}
		},
		"components": {
			"minecraft:emitter_initialization": {
				"creation_expression": "variable.size = 0.15;"
			},
			"minecraft:emitter_local_space": {
				"position": true,
				"rotation": false
			},
			"minecraft:emitter_rate_instant": {
				"num_particles": 300
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 1
			},
			"minecraft:emitter_shape_box": {
				"offset": [0, 1, 0],
				"half_dimensions": [0.75, 1, 0.75],
				"direction": "inwards"
			},
			"minecraft:particle_initialization": {
				"per_render_expression": "variable.colortint = Math.random(1, 0);"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "Math.random(1, 3)"
			},
			"minecraft:particle_initial_speed": 5,
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [0, 0.5, 0],
				"linear_drag_coefficient": 2.5
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["Math.min(v.size * (v.particle_lifetime - v.particle_age), v.size)", "Math.min(v.size * (v.particle_lifetime - v.particle_age), v.size)"],
				"facing_camera_mode": "lookat_xyz",
				"uv": {
					"texture_width": 16,
					"texture_height": 16,
					"uv": [2, 3],
					"uv_size": [1, 1]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": ["v.colortint", 0, "v.colortint * 0.5", 1]
			}
		}
	}
}