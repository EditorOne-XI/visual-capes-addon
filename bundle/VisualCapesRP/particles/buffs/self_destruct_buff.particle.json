{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "visualcapes:self_destruct",
			"basic_render_parameters": {
				"material": "particles_alpha",
				"texture": "textures/particle/particles"
			}
		},
		"events": {
			"explosion": {
				"sequence": [
					{
						"particle_effect": {
							"effect": "visualcapes:explosion_wave",
							"type": "emitter",
							"pre_effect_expression": "v.y_offset = 0;"
						}
					},
					{
						"particle_effect": {
							"effect": "visualcapes:explosion_smoke",
							"type": "emitter"
						}
					}
				]
			}
		},
		"components": {
			"minecraft:emitter_initialization": {
				"creation_expression": "variable.size = 0.50;"
			},
			"minecraft:emitter_local_space": {
				"position": true,
				"rotation": false
			},
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 2500,
				"max_particles": 10000
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": "Math.random(1, 3)"
			},
			"minecraft:emitter_lifetime_events": {
				"creation_event": "explosion"
			},
			"minecraft:emitter_shape_point": {},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "Math.random(1.5, 3.5)"
			},
			"minecraft:particle_expire_if_not_in_blocks": ["minecraft:air"],
			"minecraft:particle_initial_speed": 2.5,
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [0, "(Math.random(-1, 1) * 1.8) - 0.5", 0],
				"linear_drag_coefficient": 0.1
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["Math.min(v.size * (v.particle_lifetime - v.particle_age), v.size)", "Math.min(v.size * (v.particle_lifetime - v.particle_age), v.size)"],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 16,
					"texture_height": 16,
					"flipbook": {
						"base_UV": [0, 3],
						"size_UV": [1, 1],
						"step_UV": [1, 0],
						"frames_per_second": 1,
						"max_frame": 2,
						"loop": true
					}
				}
			}
		}
	}
}