{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "visualcapes:void_terminate",
			"basic_render_parameters": {
				"material": "particles_alpha",
				"texture": "textures/particle/particles"
			}
		},
		"events": {
			"disc": {
				"particle_effect": {
					"effect": "visualcapes:void_warp",
					"type": "emitter"
				}
			}
		},
		"components": {
			"minecraft:emitter_local_space": {
				"position": true,
				"rotation": true
			},
			"minecraft:emitter_rate_instant": {
				"num_particles": 2500
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 1
			},
			"minecraft:emitter_lifetime_events": {
				"creation_event": ["disc"]
			},
			"minecraft:emitter_shape_sphere": {
				"offset": [0, 1, 0],
				"radius": "v.pull",
				"surface_only": true,
				"direction": "inwards"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "v.drag != 0 ? Math.random(1, 2) - 0.5 : 0.67"
			},
			"minecraft:particle_initial_speed": "v.pull * (v.drag != 0 ? v.invert : 1.5)",
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [0, "Math.min(10, v.particle_age) * v.drag", 0],
				"linear_drag_coefficient": "(v.particle_age - 1) * v.drag"
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["v.drag != 0 ? v.size * (v.particle_lifetime - v.particle_age) : v.size", "v.drag != 0 ? v.size * (v.particle_lifetime - v.particle_age) : v.size"],
				"facing_camera_mode": "lookat_xyz",
				"uv": {
					"texture_width": 16,
					"texture_height": 16,
					"uv": [6, 11],
					"uv_size": [1, 1]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": ["Math.min(v.particle_age, 0.5) * v.drag", "Math.min(v.particle_age, 0.5) * v.drag", "Math.min(v.particle_age, 1) * v.drag", 1]
			}
		}
	}
}