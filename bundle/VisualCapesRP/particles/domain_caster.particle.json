{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "visualcapes:domain_caster",
			"basic_render_parameters": {
				"material": "particles_alpha",
				"texture": "textures/particle/particles"
			}
		},
		"events": {
			"rage": {
				"sequence": [
					{
						"particle_effect": {
							"effect": "visualcapes:domain_ring",
							"type": "emitter"
						}
					}
				]
			}
		},
		"components": {
			"minecraft:emitter_initialization": {
				"creation_expression": "variable.size = 0.30;"
			},
			"minecraft:emitter_local_space": {
				"position": true,
				"rotation": false
			},
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 1000,
				"max_particles": 100
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 0.5
			},
			"minecraft:emitter_lifetime_events": {
				"creation_event": "rage"
			},
			"minecraft:emitter_shape_point": {
				"offset": ["Math.sin(variable.particle_random_1*360) * 0.5", "Math.random(0, 2)", "Math.cos(variable.particle_random_1*360) * 0.5"],
				"direction": [0, 1, 0]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "Math.random(0.10, 0.75)"
			},
			"minecraft:particle_initial_speed": "Math.random(1, 4)",
			"minecraft:particle_motion_dynamic": {
				"linear_drag_coefficient": -2.5
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["v.size * (v.particle_lifetime - v.particle_age)", "v.size * (v.particle_lifetime - v.particle_age)"],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 16,
					"texture_height": 16,
					"uv": [0, 3],
					"uv_size": [1, 1]
				}
			}
		}
	}
}