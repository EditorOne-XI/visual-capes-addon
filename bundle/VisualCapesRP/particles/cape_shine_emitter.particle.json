			"minecraft:particle_appearance_billboard": {
				"size": ["0.1 - (v.particle_age * 0.1)", "0.1 - (v.particle_age * 0.1)"],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 16,
					"texture_height": 16,
					"uv": [2, 6],
					"uv_size": [1, 1]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": ["Math.max(v.particle_random_1, 0.5)", "Math.max(v.particle_random_1, 0.5) / 2", "Math.random(0, 1)", 1]
			}
		}
	}
}