{
  "namespace": "capes_common_ui",

  "spacer": {
    "type": "panel",
    "$spacer|default": [ 0, 5 ],
    "size": "$spacer"
  },

  "label": {
    "type": "panel",
    "$text_color|default": "$f_color_format",
    "$text|default": "",
    "$text_alignment|default": "left",
    "$shadow|default": false,
    "$text_scale|default": 1.0,
    "$text_anchor_from|default": "top_left",
    "$text_anchor_to|default": "top_left",
    "size": [ "100%", "100%c" ],
    "controls": [
      {
        "text": {
          "type": "label",
          "size": [ "default", "default" ],
          "max_size": [ "100%", "default" ],
          "color": "$text_color",
          "text": "$text",
          "text_alignment": "$text_alignment",
          "shadow": "$shadow",
          "font_scale_factor": "$text_scale",
          "localize": true,
          "anchor_from": "$text_anchor_from",
          "anchor_to": "$text_anchor_to"
        }
      }
    ]
  },

  "title_label": {
    "type": "panel",
    "$title|default": "",
    "size": [ "100%", "100%c + 2px" ],
    "controls": [
      {
        "text": {
          "type": "label",
          "size": [ "100%", "default" ],
          "color": [ 1.0, 1.0, 1.0 ],
          "text": "$title",
          "text_alignment": "left",
          "font_type": "MinecraftTen",
          "font_scale_factor": 1.5,
          "localize": true,
          "anchor_from": "top_left",
          "anchor_to": "top_left"
        }
      }
    ]
  },

  "description_label": {
    "type": "panel",
    "$description_color|default": "$main_header_text_color",
    "$description|default": "",
    "size": [ "100%", "100%c + 4px" ],
    "controls": [
      {
        "text": {
          "type": "label",
          "size": [ "default", "default" ],
          "max_size": [ "100%", "default" ],
          "color": "$description_color",
          "text": "$description",
          "text_alignment": "left",
          "localize": true,
          "anchor_from": "left_middle",
          "anchor_to": "left_middle"
        }
      }
    ]
  },

  "image_panel": {
    "type": "panel",
    "$size|default": [ "100%", "100%c + 4px" ],
    "$image_size|default": [ "100%", "100%x" ],
    "$image_offset|default": [ 0, 0 ],
    "$texture|default": "textures/blocks/barrier",
    "$image_anchor_from|default": "top_middle",
    "$image_anchor_to|default": "top_middle",
    "size": "$size",
    "controls": [
      {
        "image": {
          "type": "image",
          "size": "$image_size",
          "offset": "$image_offset",
          "texture": "$texture",
          "anchor_from": "$image_anchor_from",
          "anchor_to": "$image_anchor_to"
        }
      }
    ]
  },

  "visual_capes_addon_logo": {
    "type": "stack_panel",
    "size": [ "100%", "100%c + 5px" ],
    "anchor_from": "top_middle",
    "anchor_to": "top_middle",
    "controls": [
      {
        "logo@capes_common_ui.image_panel": {
          "$image_size": [ "75%", "21.09375%x" ],
          "$texture": "textures/capes/ui/addon_logo"
        }
      },
      {
        "editoronexiallcapesperplayeraddon": {
          "type": "label",
          "size": [ "100%", 10 ],
          "offset": [ 0, -30 ],
          "color": "$f_color_format",
          "text": "By EditorOne XI",
          "text_alignment": "center",
          "anchor_from": "bottom_middle",
          "anchor_to": "bottom_middle"
        }
      },
      {
        "versionbuildallcapesperplayeraddon": {
          "type": "label",
          "size": [ "100%", 10 ],
          "offset": [ 0, -20 ],
          "color": "$7_color_format",
          "text": "Version 2.6.0",
          "text_alignment": "center",
          "anchor_from": "bottom_middle",
          "anchor_to": "bottom_middle"
        }
      }
    ]
  },

  "about_tab_toggle_base@common_toggles.light_text_toggle": {
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "size": [ "fill", "30px" ],
    "$button_size_override": [ "100%", "100% + 1px" ],
    "$radio_toggle_group": true,
    "$toggle_name": "about_capes_tab",
    "$toggle_group_default_selected": "$info_tab_default_index",
    "$toggle_tab_focus_binding_type": "global",
    "$toggle_tab_focus_binding_name": "#about_capes_tab_focus_precedence",
    "$toggle_on_hover_binding_type": "global",
    "$toggle_on_hover_binding_name": "#toggle_on_hover",
    "$toggle_tts_toggle_on_text": "accessibility.state.selected",
    "$toggle_tts_toggle_off_text": "accessibility.state.unselected",
    "$toggle_tts_name": "accessibility.tab.tts.title"
  },

  "capes_list_toggle_base@common_toggles.dark_text_toggle": {
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "size": [ "fill", "20px" ],
    "$button_size_override": [ "100%", "100% + 1px" ],
    "$radio_toggle_group": true,
    "$toggle_name": "capes_list_tab",
    "$toggle_group_default_selected": "$capes_list_default_index",
    "$toggle_tab_focus_binding_type": "global",
    "$toggle_tab_focus_binding_name": "#capes_list_tab_focus_precedence",
    "$toggle_on_hover_binding_type": "global",
    "$toggle_on_hover_binding_name": "#toggle_on_hover",
    "$toggle_tts_toggle_on_text": "accessibility.state.selected",
    "$toggle_tts_toggle_off_text": "accessibility.state.unselected",
    "$toggle_tts_name": "accessibility.tab.tts.title"
  },

  "reward_requirements_toggle_base@common_toggles.light_text_toggle": {
    "anchor_from": "top_middle",
    "anchor_to": "top_middle",
    "size": [ "100%", "20px" ],
    "$button_size_override": [ "100%", "100% + 1px" ],
    "$toggle_name": "reward_requirements_toggle",
    "$toggle_on_hover_binding_type": "global",
    "$toggle_on_hover_binding_name": "#toggle_on_hover",
    "$toggle_tts_toggle_on_text": "accessibility.state.selected",
    "$toggle_tts_toggle_off_text": "accessibility.state.unselected",
    "$toggle_tts_name": "accessibility.tab.tts.title"
  },

  "about_visual_capes_settings_button@settings_common.section_toggle_base": {
    "$toggle_view_binding_name": "about_capes_toggle",
    "$glyph_texture": "textures/capes/ui/visual_capes_glyph",
    "$glyph_color_texture": "textures/capes/ui/visual_capes_glyph_color",
    "$glyph_size": [ 16, 16 ],
    "$button_text": "Visual Capes Add-on",
    "$toggle_property_bag": {
      "#panel_title": "About Visual Capes Add-on"
    }
  },

  "cape_display_template": {
    "type": "image",
    "$elytra_texture": "default_elytra",
    "layer": 2,
    "size": [ "100%", "100%c" ],
    "texture": "textures/capes/ui/capes_template_bg",
    "controls": [
      {
        "cape_display_stack_panel": {
          "type": "stack_panel",
          "orientation": "horizontal",
          "size": [ "100%", 32 ],
          "controls": [
            {
              "cape_image@capes_common_ui.cape_image": {
                "$toggle_handle": "$cape_toggle",
                "$cape_texture": "$cape_texture",
                "$elytra_texture": "$elytra_texture"
              }
            },
            {
              "cape_text": {
                "type": "panel",
                "layer": 4,
                "size": [ "fill", 32 ],
                "anchor_from": "right_middle",
                "anchor_to": "right_middle",
                "controls": [
                  {
                    "cape_name": {
                      "type": "label",
                      "$cape_name|default": "",
                      "size": [ "100% - 20px", "default" ],
                      "offset": [ 10, -6 ],
                      "color": [  0.0, 0.0, 0.0  ],
                      "text": "$cape_name",
                      "text_alignment": "left",
                      "font_type": "MinecraftTen",
                      "font_scale_factor": 1.2,
                      "anchor_from": "left_middle",
                      "anchor_to": "left_middle"
                    }
                  },
                  {
                    "cape_namespace": {
                      "type": "label",
                      "$cape_namespace|default": "",
                      "size": [ "100% - 20px", "default" ],
                      "offset": [ 10, 5 ],
                      "color": [  0.0, 0.0, 0.0  ],
                      "text": "$cape_namespace",
                      "text_alignment": "left",
                      "font_type": "smooth",
                      "font_scale_factor": 1.2,
                      "anchor_from": "left_middle",
                      "anchor_to": "left_middle"
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  },

  "cape_image": {
    "type": "panel",
    "$toggle_handle|default": "cape_image_toggle",
    "ignored": "($cape_texture = '')",
    "size": [ 32, 32 ],
    "layer": 4,
    "controls": [
      {
        "cape_image_toggle_control@capes_common_ui.toggle_control": {
          "layer": 6,
          "$toggle_name": "$toggle_handle",
          "$toggle_view_binding_name": "$toggle_handle",
          "$template_toggle": "capes_common_ui.cape_image_toggle_control_handle",
          "size": [ 32, 32 ],
          "anchor_from": "left_middle",
          "anchor_to": "left_middle"
        }
      },
      {
        "cape": {
          "type": "image",
          "layer": 5,
          "size": [ "100%", "100%" ],
          "$cape_texture|default": "",
          "texture": "('textures/capes/' + $cape_texture)",
          "bindings": [ 
            {
              "binding_type": "view",
              "source_control_name": "$toggle_handle",
              "source_property_name": "(not #toggle_state)",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "elytra": {
          "type": "image",
          "size": [ "100%", "100%" ],
          "texture": "textures/ui/cell_image",
          "controls": [ 
            {
              "elytra_image": {
                "type": "image",
                "size": [ "85%", "85%" ],
                "$elytra_texture|default": "default_elytra",
                "texture": "('textures/capes/' + $elytra_texture)"
              }
            }
          ],
          "bindings": [ 
            {
              "binding_type": "view",
              "source_control_name": "$toggle_handle",
              "source_property_name": "#toggle_state",
              "target_property_name": "#visible"
            }
          ]
        }
      }
    ]
  },

  "hotbar_slot_opaque": {
    "type": "image",

    "$slot_size|default": [ 20, 20 ],
    "$item_slot_layer|default": 2,
    "$display_item|default": true,
    "$use_item_id|default": true,
    "$item_id|default": 0,
    "$item_data|default": 0,
    "$item_image|default": "blocks/barrier",
    "$item_anims|default": [],
    "$item_slot_propagate_alpha|default": false,
    "$item_name_blank|default": false,
    "$use_item_count|default": false,
    "$item_count|default": "1",

    "size": "$slot_size",
    "layer": "($item_slot_layer + 1)",
    "texture": "textures/capes/ui/hotbar_0",
    "propagate_alpha": "$item_slot_propagate_alpha",
    "controls": [
      {
        "item_image": {
          "type": "image",
          "ignored": "$use_item_id",
          "size": [ 16, 16 ],
          "layer": 2,
          "texture": "('textures/' + $item_image)",
          "propagate_alpha": "$item_slot_propagate_alpha",
          "anchor_from": "center",
          "anchor_to": "center",
          "anims": "$item_anims"
        }
      },
      {
        "item_aux": {
          "type": "custom",
          "ignored": "(not $use_item_id)",
	        "renderer": "inventory_item_renderer",
	        "size": [ 16, 16 ],
	        "layer": 2,
          "propagate_alpha": "$item_slot_propagate_alpha",
	        "anchor_from": "center",
	        "anchor_to": "center",
	        "anims": "$item_anims",
	        "property_bag": {
	          "#item_id_aux": "(($item_id * 65536) + $item_data)"
	        }
        }
      },
      {
        "item_count": {
          "type": "label",
          "ignored": "(not $use_item_count)",
          "size": [ 18, 10 ],
          "layer": 3,
          "text": "$item_count",
          "text_alignment": "right",
          "propagate_alpha": "$item_slot_propagate_alpha",
          "shadow": true,
          "anchor_from": "center",
          "anchor_to": "top_middle",
          "anims": "$item_anims"
        }
      },
      {
        "item_name@common.button": {
          "ignored": "$item_name_blank",
          "size": "$slot_size",
          "layer": 1,
          "$pressed_button_name": "unset",
          "propagate_alpha": "$item_slot_propagate_alpha",
          "anims": "$item_anims",
          "controls": [
            { "hover@capes_common_ui.item_name_panel": {} }
          ]
        }
      }
    ],
    "variables": [
      {
        "requires": "($use_item_id and ($item_id = 0) and ($item_data = 0))",
        "$item_name_blank": true
      },
      {
        "requires": "(not ($item_count = '1'))",
        "$use_item_count": true
      }
    ]
  },

  "item_name_panel": {
    "type": "panel",

    "$item_name_border_offset|default": [ 22, 0 ],
    "$item_name_label_color|default": "$f_color_format",
    "$item_name_label|default": "item.air.name",
    "$highlight_size|default": [ 18, 18 ],
    "$highlight_layer_subtract|default": 0,

    "size": "$slot_size",
    "layer": 2,
    "propagate_alpha": "$item_slot_propagate_alpha",
    "anims": "$item_anims",
    "controls": [
      {
        "item_name_border": {
          "type": "image",
          "allow_clipping": false,
          "size": [ "100%c + 8px", "100%c + 8px" ],
          "offset": "$item_name_border_offset",
          "layer": 150,
          "texture": "textures/ui/purpleBorder",
          "propagate_alpha": "$item_slot_propagate_alpha",
          "anchor_from": "left_middle",
          "anchor_to": "left_middle",
          "anims": "$item_anims",
          "controls": [
            {
              "item_name_label": {
                "type": "label",
                "size": [ "default", "default" ],
                "min_size": [ "default", 10 ],
                "layer": 2,
                "color": "$item_name_label_color",
                "text": "$item_name_label",
                "localize": true,
                "propagate_alpha": "$item_slot_propagate_alpha",
                "anchor_from": "center",
                "anchor_to": "center",
                "anims": "$item_anims"
              }
            }
          ]
        }
      },
      {
        "white_border@common.white_border_slot": {
          "size": "$slot_size",
          "layer": 1,
          "propagate_alpha": "$item_slot_propagate_alpha",
          "anims": "$item_anims",
          "controls": [
            {
              "highlight_slot@common.highlight_slot": {
                "layer": "(-4 - $highlight_layer_subtract)",
                "propagate_alpha": "$item_slot_propagate_alpha",
                "anims": "$item_anims"
              }
            }
          ]
        }
      }
    ]
  },

  "item_id_panel": {
    "type": "panel",
    "size": [ "100%", 25 ],
    "controls": [
      {
        "black_bg": {
          "type": "image",
          "size": [ "100% - 10px", "100% - 6px" ],
          "alpha": 0.5,
          "texture": "textures/ui/Black",
          "controls": [
            {
              "number_indicator": {
                "type": "label",
                "$row|default": "0",
                "size": [ "default", 25 ],
                "offset": [ -50, 0 ],
                "color": [ 1, 1, 1 ],
                "text": "$row",
                "font_type": "MinecraftTen",
                "font_scale_factor": 1.5,
                "anchor_from": "center",
                "anchor_to": "center"
              }
            },
            {
              "item_id_template@capes_common_ui.hotbar_slot_opaque": {
                "offset": [ 50, 0 ],
                //"$item_name_label": "('Item AUX ID: ' + ($item_id * 65536))"
                "$item_name_blank": true
              }
            }
          ]
        }
      }
    ]
  },

